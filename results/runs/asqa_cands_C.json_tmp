ity:5]</s>"], "q_idx": 385, "candidates": [{"node_id": 1, "parent": 0, "depth": 1, "p_idx": 0, "pred": "[Relevant]The song \"I Don't Want to Live Without Your Love\" was originally sung by the group Chicago in 1988.[Fully supported][Continue to Use Evidence]The song was also covered by American singer and songwriter Mariah Carey for her album \"The Emancipation of Mimi\" in 2005.[Utility:5]</s>", "processed_pred": "[Relevant]The song \"I Don't Want to Live Without Your Love\" was originally sung by the group Chicago in 1988.[Fully supported][Continue to Use Evidence]The song was also covered by American singer and songwriter Mariah Carey for her album \"The Emancipation of Mimi\" in 2005.[Utility:5]</s>", "beam_score": 1.9825129724422048, "ctx": {"title": "I Don't Wanna Live Without Your Love", "text": "I Don't Wanna Live Without Your Love \"I Don't Wanna Live Without Your Love\" is a hit song written by Diane Warren and Albert Hammond for the group Chicago and recorded for their album \"Chicago 19\" (1988), with Bill Champlin singing lead vocals. It is the first Chicago single to feature Champlin performing all lead vocals himself. The first single released from \"Chicago 19\", it reached number three on the U.S. \"Billboard\" Hot 100 chart. The B-side of the single was \"I Stand Up\" written by Robert Lamm and Gerard McMahon. The song was featured in the Netflix original movie"}, "final_score": 1.9825129724422048, "relevance_score": 0.9993332978453775, "ground_score": 0.9831796745968274, "utility_score": 0.0, "seq_score": -0.34457195235983784, "relevance_probs": {"[Irrelevant]": 0.0006666926583674826, "[Relevant]": 0.9993190637172804}, "support_probs": [{"[Fully supported]": 0.9785360582566379, "[Partially supported]": 0.008803243717013685, "[No support / Contradictory]": 0.012414563481528883}], "utility_probs": [{"[Utility:1]": 0.00010108568387314117, "[Utility:2]": 0.00016280139337902162, "[Utility:3]": 5.528230566143496e-05, "[Utility:4]": 0.0008013365429874925